{
  "version": 2,
  "builds": [
    {
      "src": "oxlet/wsgi.py",
      "use": "@vercel/python",
      "config": { "maxLambdaSize": "15mb", "runtime": "python3.12" }
    }
  ],
  "routes": [
    { "src": "/(.*)", "dest": "oxlet/wsgi.py" }
  ],
  "crons": [
    {
      "path": "/api/cron/send_line",
      "schedule": "0 2 * * *"
    }
  ]
}
