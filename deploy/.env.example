# ───────────────────────────────────────────────────────────────
# .env สำหรับ VPS (Hostinger) — คัดลอกไฟล์นี้เป็น /opt/oxlet/.env แล้วเติมค่าจริง
# ค่า SECRET (มี ***) → copy จาก Vercel dashboard (Settings → Environment Variables)
# ห้าม commit ไฟล์ .env จริงขึ้น git
# ───────────────────────────────────────────────────────────────

# ── โหมด/ความปลอดภัย ──
DEBUG=False
# bootstrap: ตั้ง False ก่อน "ติด SSL เสร็จ" เพื่อกัน redirect loop · พอ cert ติดแล้วเปลี่ยนเป็น True
SECURE_SSL_REDIRECT=False

# ── โดเมน (แก้เป็นโดเมนจริงของคุณ) ──
ALLOWED_HOSTS=srv1793506.hstgr.cloud,127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=https://srv1793506.hstgr.cloud
SITE_URL=https://srv1793506.hstgr.cloud

# ── Django ──
DJANGO_SECRET_KEY=***copy-from-vercel***

# ── Admin break-glass login (เปลี่ยนรหัสให้ปลอดภัย) ──
OXLET_ADMIN_USER=admin
OXLET_ADMIN_PASSWORD=***copy-from-vercel***

# ── Google Sheets (service account · บัญชีใหม่ project gen-lang-client-0431582933) ──
# GOOGLE_PRIVATE_KEY = ค่า "private_key" จากไฟล์ JSON ของ service account (วางทั้งก้อนรวม \n ครอบด้วย ")
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# email เป็น default ใน settings.py แล้ว — ตั้งทับได้ถ้าจะเปลี่ยนบัญชีอีก
# GOOGLE_SERVICE_ACCOUNT_EMAIL=google-account-oxletauto@gen-lang-client-0431582933.iam.gserviceaccount.com

# ── LINE Messaging API (push Flex / followup) ──
LINE_CHANNEL_ACCESS_TOKEN=***copy-from-vercel***

# ── LINE Login (OAuth) — ต้องอัปเดต callback ใน LINE Login channel ให้ตรงโดเมนใหม่ ──
LINE_LOGIN_CHANNEL_ID=***copy-from-vercel***
LINE_LOGIN_CHANNEL_SECRET=***copy-from-vercel***
LINE_LOGIN_CALLBACK=https://srv1793506.hstgr.cloud/auth/line/callback

# ── Gemini (OCR + insights) ──
GEMINI_API_KEY=***copy-from-vercel***
GEMINI_MODEL=gemini-3.1-pro-preview

# ── Cron secret (ใช้กับ crontab ในเครื่อง ยิง /api/cron/tick) ──
CRON_SECRET=***copy-from-vercel***

# ── Supabase: ปิด (ลบ project ไปแล้ว · VPS มี in-memory cache อยู่แล้ว) ──
USE_SUPABASE=False

# ── ระบบติดตามรถ cars/ (/track/) — Postgres ในเครื่อง VPS ──
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=oxlet
DB_USER=oxlet
DB_PASSWORD=***ตั้งรหัส DB เอง***
DB_SSLMODE=disable
# ── รูป/วิดีโอรถ → Google Drive (ออปชั่น) ──
# ไม่ตั้ง = เก็บลงดิสก์ VPS (/opt/oxlet/media · nginx เสิร์ฟ /media/) — รูปขึ้นทันที ไม่ต้องตั้งอะไร
# ตั้งเมื่ออยากเก็บบน Drive แทน: ขอ token ครั้งเดียว `python manage.py gdrive_auth` (ดู DEPLOY.md 13.1)
GDRIVE_CLIENT_ID=
GDRIVE_CLIENT_SECRET=
GDRIVE_REFRESH_TOKEN=
# โฟลเดอร์แม่ที่เก็บโฟลเดอร์รถทุกคัน (ได้จาก `python manage.py gdrive_setup` · ว่าง = root ของไดรฟ์)
GDRIVE_ROOT_FOLDER_ID=
# ลิมิตขนาดไฟล์ต่อชิ้น (MB) — กัน RAM/แบนด์วิดท์เวลาอัปวิดีโอใหญ่
GDRIVE_MAX_UPLOAD_MB=200

# ── LINE push ของ tracking (ออปชั่น — ไม่ตั้ง = ไม่ push เงียบๆ) ──
# LINE_CHANNEL_TOKEN=
# LINE_GROUP_ID=
