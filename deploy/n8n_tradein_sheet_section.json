      "parameters": {
        "jsCode": "// =====================================================\n// Clean Sheet Data\n// ลบ field ที่ไม่ต้องการออก เหลือเฉพาะที่ Merge Comments ใช้\n// =====================================================\n\nconst data = $json;\n\nreturn [{\n  json: {\n    row_number: data.row_number,\n    Code: data.Code,\n    'คอมเมนท์จัดซื้อ': data['คอมเมนท์จัดซื้อ'] || \"\",\n  }\n}];\n"
      },
