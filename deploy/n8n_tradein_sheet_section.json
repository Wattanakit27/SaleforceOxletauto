    {
      "parameters": {
        "jsCode": "// =====================================================\n// Merge Comments - FINAL VERSION\n// รวมคอมเมนท์ด้วย \" / \" คั่น\n// =====================================================\n\nconst items = $input.all();\n\nconsole.log(\"=== MERGE COMMENTS ===\");\nconsole.log(\"Total items:\", items.length);\n\nif (!items || items.length === 0) {\n  console.log(\"❌ No items\");\n  return [];\n}\n\n// หาข้อมูลใหม่ (จาก If Node — ทาง false = purchase_comment)\nlet newData = null;\n\nfor (const item of items) {\n  const j = item.json || {};\n  if (j._mode === \"purchase_comment\") {\n    newData = j;\n    console.log(\"✅ Found NEW data:\", { code: j.code, comment: j.comment });\n    break;\n  }\n}\n\nif (!newData || !newData.code || !newData.comment) {\n  // ★ ถ้าเจอแถวแบบ case_form แปลว่าต่อสาย If1 กลับด้าน (true/false สลับกัน)\n  const wrong = items.find((it) => (it.json || {})._mode === \"case_form\");\n  if (wrong) {\n    throw new Error(\n      \"ต่อสายผิด: โหนดนี้ได้รับ _mode=case_form (เคสใหม่) ซึ่งต้องไปทาง 'เพิ่มแถวเคสใหม่ (ชีต)' \" +\n      \"· ทาง false ของ If1 เท่านั้นที่ควรต่อมาที่นี่\"\n    );\n  }\n  console.log(\"❌ Missing new data\");\n  return [];\n}\n\n// หาข้อมูลเก่า (จาก Google Sheets)\nlet oldData = null;\n\nfor (const item of items) {\n  const j = item.json || {};\n  if (j.row_number !== undefined && j.Code) {\n    const sheetCode = (j.Code || \"\").trim();\n    const targetCode = (newData.code || \"\").trim();\n\n    if (sheetCode === targetCode) {\n      oldData = j;\n      console.log(\"✅ Found OLD data:\", {\n        Code: j.Code,\n        oldComment: j['คอมเมนท์จัดซื้อ'],\n        rowNumber: j.row_number\n      });\n      break;\n    }\n  }\n}\n\n// รวมคอมเมนท์\nconst code = newData.code.trim();\nconst newComment = newData.comment.trim();\nconst oldComment = oldData ? (oldData['คอมเมนท์จัดซื้อ'] || \"\").trim() : \"\";\n\nlet mergedComment = newComment;\n\nif (oldComment && oldComment.length > 0) {\n  if (oldComment === newComment) {\n    console.log(\"⚠️ Same comment - skip merge\");\n    mergedComment = newComment;\n  } else if (oldComment.includes(newComment)) {\n    // ★ เคยเติมข้อความนี้ไปแล้ว — ไม่ต่อซ้ำ\n    console.log(\"⚠️ Already contains - skip merge\");\n    mergedComment = oldComment;\n  } else {\n    mergedComment = `${oldComment} / ${newComment}`;\n    console.log(\"📝 Merged with ' / '\");\n  }\n} else {\n  console.log(\"📝 New comment only\");\n}\n\nconsole.log(\"✅ FINAL OUTPUT:\", { code, comment: mergedComment });\n\nreturn [{\n  json: {\n    code: code,\n    comment: mergedComment\n  }\n}];\n"
      },
